{
  "database": "stripe_nosql",
  "deployment": {
    "topology": "Replica set 3 nœuds (1 primaire + 2 secondaires) multi-AZ, puis cluster shardé (mongos + config servers) au-delà de ~2 To",
    "write_concern": "majority (données ML et feedback) / w:1 (logs, latence prioritaire)",
    "read_preference": "primaryPreferred pour le scoring temps réel, secondaryPreferred pour l'analytique",
    "multi_document_transactions": "Utilisées pour l'écriture atomique ml_features + fraud_alerts (session.withTransaction). Évitées sur les logs (coût inutile).",
    "binary_and_xml": {
      "binary": "GridFS (bucket `evidence`) pour les pièces jointes de disputes (PDF, images) — ou S3 + référence `s3_key` dans la collection `documents` au-delà de 16 Mo.",
      "xml": "Webhooks bancaires / ISO 20022 convertis en BSON à l'ingestion (xmltodict) ; l'original XML est archivé dans GridFS pour la preuve d'audit."
    }
  },

  "collections": {

    "logs": {
      "description": "Logs techniques : erreurs, accès, audit applicatif. Time-series collection (MongoDB >= 5.0).",
      "collection_options": {
        "timeseries": { "timeField": "timestamp", "metaField": "meta", "granularity": "seconds" },
        "expireAfterSeconds": 7776000
      },
      "retention": "90 jours (TTL natif time-series). Les logs `audit` sont copiés vers S3 Object Lock avant expiration.",
      "shard_key": { "meta.service": 1, "timestamp": 1 },
      "example": {
        "_id": "log_a1b2c3d4",
        "timestamp": { "$date": "2026-09-10T14:32:01Z" },
        "meta": { "service": "payment-api", "type": "error", "severity": "critical" },
        "message": "Timeout on charge attempt",
        "metadata": {
          "transaction_id": "ch_3Mxxx",
          "merchant_id": "mer_001",
          "http_status": 504,
          "latency_ms": 3200
        },
        "trace": {
          "request_id": "req_xyz789",
          "ip_address": "185.12.44.0",
          "user_agent": "Mozilla/5.0"
        }
      },
      "validator": {
        "$jsonSchema": {
          "required": ["timestamp", "meta", "message"],
          "properties": {
            "timestamp": { "bsonType": "date" },
            "meta": {
              "bsonType": "object",
              "required": ["service", "type", "severity"],
              "properties": {
                "type": { "enum": ["error", "access", "audit"] },
                "severity": { "enum": ["debug", "info", "warning", "error", "critical"] }
              }
            }
          }
        }
      },
      "indexes": [
        { "keys": { "meta.service": 1, "timestamp": -1 }, "note": "créé automatiquement par la time-series collection" },
        { "keys": { "meta.severity": 1, "timestamp": -1 } },
        { "keys": { "metadata.transaction_id": 1 }, "note": "jointure applicative vers l'OLTP" }
      ]
    },

    "user_sessions": {
      "description": "Sessions utilisateurs : clickstream embarqué, device, géo. 1 document = 1 session.",
      "retention": "180 jours (index TTL sur session_start)",
      "shard_key": { "customer_id": "hashed" },
      "embedding_rule": "events embarqués car toujours lus avec la session et bornés (< 500 events). Au-delà : bucket pattern (1 document par session ET par tranche de 200 events).",
      "example": {
        "_id": "sess_s9k2p1",
        "customer_id": "cus_001",
        "session_start": { "$date": "2026-09-10T10:00:00Z" },
        "session_end": { "$date": "2026-09-10T10:18:42Z" },
        "duration_seconds": 1122,
        "device": { "type": "mobile", "os": "iOS 17", "browser": "Safari", "screen_resolution": "390x844" },
        "geo": { "ip_address": "82.64.12.0", "country_code": "FR", "city": "Paris" },
        "events": [
          { "event": "page_view", "page": "/checkout", "timestamp": { "$date": "2026-09-10T10:00:05Z" } },
          { "event": "click", "element": "pay_button", "timestamp": { "$date": "2026-09-10T10:01:22Z" } },
          { "event": "page_view", "page": "/confirmation", "timestamp": { "$date": "2026-09-10T10:01:35Z" } }
        ],
        "event_count": 3,
        "converted": true,
        "transaction_id": "ch_3Mxxx"
      },
      "validator": {
        "$jsonSchema": {
          "required": ["customer_id", "session_start", "device", "events"],
          "properties": {
            "session_start": { "bsonType": "date" },
            "events": { "bsonType": "array", "maxItems": 500 },
            "converted": { "bsonType": "bool" }
          }
        }
      },
      "indexes": [
        { "keys": { "customer_id": 1, "session_start": -1 } },
        { "keys": { "session_start": 1 }, "options": { "expireAfterSeconds": 15552000 }, "note": "TTL 180 jours" },
        { "keys": { "transaction_id": 1 }, "options": { "sparse": true } },
        { "keys": { "converted": 1, "event_count": -1 }, "note": "règle ESR : Equality (converted) puis Sort (event_count)" },
        { "keys": { "device.type": 1 } }
      ]
    },

    "ml_features": {
      "description": "Feature store online + journal de prédictions + label retardé. 1 document par transaction.",
      "retention": "Illimitée mais anonymisée (customer_id retiré) après 24 mois ou sur demande RGPD — jamais supprimée (réentraînement).",
      "shard_key": { "transaction_id": "hashed" },
      "example": {
        "_id": "feat_f7g8h9",
        "transaction_id": "ch_3Mxxx",
        "customer_id": "cus_001",
        "merchant_id": "mer_001",
        "computed_at": { "$date": "2026-09-10T14:32:02Z" },
        "model_target": "fraud_detection",
        "features": {
          "amount_zscore": 2.34,
          "transactions_last_1h": 3,
          "transactions_last_24h": 12,
          "avg_amount_30d": 87.5,
          "distinct_countries_30d": 2,
          "geo_mismatch": true,
          "night_transaction": false,
          "velocity_score": 0.78,
          "device_seen_before": true,
          "ip_reputation_score": 0.12
        },
        "prediction": {
          "fraud_probability": 0.0342,
          "risk_level": "low",
          "action_taken": "allow",
          "model_version": "fraud-xgb-v2.4.1",
          "latency_ms": 41,
          "predicted_at": { "$date": "2026-09-10T14:32:02Z" },
          "top_shap": [
            { "feature": "geo_mismatch", "value": 0.31 },
            { "feature": "amount_zscore", "value": 0.22 },
            { "feature": "velocity_score", "value": 0.18 }
          ]
        },
        "label": {
          "is_fraud": null,
          "source": null,
          "labeled_at": null,
          "note": "renseigné 20-90 j plus tard par un dispute (chargeback) ou une revue analyste"
        }
      },
      "validator": {
        "$jsonSchema": {
          "required": ["transaction_id", "computed_at", "model_target", "features", "prediction"],
          "properties": {
            "computed_at": { "bsonType": "date" },
            "prediction": {
              "bsonType": "object",
              "required": ["fraud_probability", "risk_level", "model_version"],
              "properties": {
                "fraud_probability": { "bsonType": "double", "minimum": 0, "maximum": 1 },
                "risk_level": { "enum": ["low", "medium", "high", "critical"] }
              }
            }
          }
        }
      },
      "indexes": [
        { "keys": { "transaction_id": 1 }, "options": { "unique": true } },
        { "keys": { "customer_id": 1, "computed_at": -1 } },
        { "keys": { "prediction.risk_level": 1, "computed_at": -1 }, "note": "Q3 : Equality sur risk_level puis Sort sur computed_at (ESR)" },
        { "keys": { "prediction.model_version": 1 }, "note": "comparaison champion / challenger" },
        { "keys": { "label.is_fraud": 1, "computed_at": -1 }, "note": "extraction du dataset d'entraînement mature" }
      ]
    },

    "customer_feedback": {
      "description": "Avis et enquêtes de satisfaction. Sentiment calculé à l'ingestion (NLP).",
      "retention": "36 mois puis anonymisation (customer_id retiré, texte conservé pour l'analyse produit).",
      "shard_key": { "merchant_id": "hashed" },
      "extended_reference": "country_code et merchant_name sont dénormalisés (extended reference pattern) : attributs stables, évite un $lookup vers l'OLTP pour les analyses par pays.",
      "example": {
        "_id": "fbk_c4d5e6",
        "customer_id": "cus_001",
        "merchant_id": "mer_001",
        "merchant_name": "Acme SAS",
        "country_code": "FR",
        "transaction_id": "ch_3Mxxx",
        "submitted_at": { "$date": "2026-09-11T09:12:00Z" },
        "channel": "email_survey",
        "scores": { "overall": 4, "ease_of_payment": 5, "speed": 3 },
        "nps_score": 8,
        "text": "Paiement rapide mais confirmation un peu lente.",
        "language": "fr",
        "sentiment": { "label": "positive", "score": 0.72, "model_version": "sentiment-v1.2" },
        "tags": ["checkout", "confirmation", "speed"]
      },
      "validator": {
        "$jsonSchema": {
          "required": ["customer_id", "merchant_id", "submitted_at", "scores"],
          "properties": {
            "submitted_at": { "bsonType": "date" },
            "scores": {
              "bsonType": "object",
              "required": ["overall"],
              "properties": { "overall": { "bsonType": "int", "minimum": 1, "maximum": 5 } }
            },
            "nps_score": { "bsonType": "int", "minimum": 0, "maximum": 10 }
          }
        }
      },
      "indexes": [
        { "keys": { "merchant_id": 1, "submitted_at": -1 } },
        { "keys": { "country_code": 1, "scores.overall": 1 } },
        { "keys": { "sentiment.label": 1 } },
        { "keys": { "tags": 1 }, "note": "index multikey sur le tableau" },
        { "keys": { "text": "text" }, "note": "recherche plein texte" }
      ]
    },

    "recommendations": {
      "description": "Sortie du modèle de personnalisation (batch nocturne). 1 document par merchant et par période.",
      "retention": "12 mois",
      "shard_key": { "merchant_id": "hashed" },
      "example": {
        "_id": "rec_mer001_2026-09",
        "merchant_id": "mer_001",
        "generated_at": { "$date": "2026-09-01T03:00:00Z" },
        "valid_from": { "$date": "2026-09-01T00:00:00Z" },
        "valid_until": { "$date": "2026-10-01T00:00:00Z" },
        "recommendations": [
          { "segment": "high_value", "suggested_method": "wallet", "confidence": 0.87 },
          { "segment": "mid_value", "suggested_method": "card", "confidence": 0.73 },
          { "segment": "low_value", "suggested_method": "card", "confidence": 0.61 }
        ],
        "model_version": "personalization-v1.3"
      },
      "indexes": [
        { "keys": { "merchant_id": 1, "valid_until": -1 } },
        { "keys": { "model_version": 1 } }
      ]
    },

    "documents": {
      "description": "Métadonnées des fichiers binaires (preuves de disputes, exports) stockés dans GridFS ou S3.",
      "retention": "Durée du litige + 13 mois (règles réseaux cartes)",
      "example": {
        "_id": "doc_9f8e7d",
        "dispute_id": "dp_001",
        "merchant_id": "mer_001",
        "kind": "evidence",
        "content_type": "application/pdf",
        "size_bytes": 184233,
        "storage": { "backend": "gridfs", "file_id": "66f1a2b3c4d5e6f7a8b9c0d1" },
        "sha256": "e3b0c442...",
        "uploaded_at": { "$date": "2026-09-12T08:00:00Z" }
      },
      "indexes": [
        { "keys": { "dispute_id": 1 } },
        { "keys": { "merchant_id": 1, "uploaded_at": -1 } }
      ]
    }
  }
}
